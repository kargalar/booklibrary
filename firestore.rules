rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // ponytail: email-based admin authorization; use custom claims when admins are managed dynamically.
    function isAdmin() {
      return signedIn() &&
        request.auth.token.get('email', '') == 'm.islam0422@gmail.com' &&
        request.auth.token.get('email_verified', false) == true;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }

    function friendLinkId(first, second) {
      return first < second ? first + '_' + second : second + '_' + first;
    }

    function isFriend(first, second) {
      return signedIn() && exists(
        /databases/$(database)/documents/friendLinks/$(friendLinkId(first, second))
      );
    }

    function canEditLibrary(ownerId) {
      return signedIn() && (
        request.auth.uid == ownerId ||
        get(/databases/$(database)/documents/friendLinks/$(friendLinkId(request.auth.uid, ownerId))).data.permissions[request.auth.uid] == 'edit'
      );
    }

    function acceptedRequest(first, second) {
      let path = /databases/$(database)/documents/friendRequests/$(first + '_' + second);
      return request.auth.uid == second && exists(path) &&
        get(path).data.status == 'pending' && getAfter(path).data.status == 'accepted' &&
        request.resource.data.permissions[first] == 'read' &&
        request.resource.data.permissions[second] == get(path).data.permission;
    }

    match /users/{userId} {
      allow read: if signedIn() &&
        (request.auth.uid == userId || isFriend(request.auth.uid, userId));
      allow create, update: if signedIn() && request.auth.uid == userId &&
        (!request.resource.data.keys().hasAny(['libraryName']) ||
          (request.resource.data.libraryName is string &&
            request.resource.data.libraryName.size() > 0 &&
            request.resource.data.libraryName.size() <= 40));
    }

    match /usernames/{usernameId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() &&
        (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if signedIn() &&
        requestId == request.resource.data.fromId + '_' + request.resource.data.toId &&
        request.resource.data.fromId == request.auth.uid &&
        request.resource.data.toId != request.auth.uid &&
        request.resource.data.permission in ['read', 'edit'] &&
        request.resource.data.status == 'pending';
      allow update: if signedIn() &&
        resource.data.toId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.fromId == resource.data.fromId &&
        request.resource.data.toId == resource.data.toId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']) &&
        request.resource.data.status in ['accepted', 'rejected'];
    }

    match /friendLinks/{linkId} {
      allow read: if signedIn() &&
        request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() &&
        request.auth.uid in request.resource.data.memberIds &&
        request.resource.data.memberIds.size() == 2 &&
        request.resource.data.memberIds[0] != request.resource.data.memberIds[1] &&
        request.resource.data.permissions.keys().hasOnly(request.resource.data.memberIds) &&
        (acceptedRequest(
          request.resource.data.memberIds[0],
          request.resource.data.memberIds[1]
        ) || acceptedRequest(request.resource.data.memberIds[1], request.resource.data.memberIds[0])) &&
        linkId == friendLinkId(
          request.resource.data.memberIds[0],
          request.resource.data.memberIds[1]
        );
      allow update: if signedIn() &&
        request.auth.uid in resource.data.memberIds &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissions']) &&
        request.resource.data.permissions.keys().hasOnly(resource.data.memberIds) &&
        request.resource.data.permissions[request.auth.uid] == resource.data.permissions[request.auth.uid] &&
        request.resource.data.permissions.values().hasOnly(['read', 'edit']);
    }

    match /books/{bookId} {
      allow read: if signedIn() && resource.data.get('recordType', '') == 'book';
      allow create: if signedIn() &&
        request.resource.data.get('recordType', '') == 'book' &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.author is string;
      allow update: if signedIn() &&
        resource.data.get('recordType', '') == 'book' &&
        request.resource.data.get('recordType', '') == 'book' &&
        (
          resource.data.get('libraryOwnerCounts', {}).get(request.auth.uid, 0) > 0 ||
          request.resource.data.get('libraryOwnerCounts', {}).get(request.auth.uid, 0) >
            resource.data.get('libraryOwnerCounts', {}).get(request.auth.uid, 0) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'recordType', 'isbn', 'isbn10', 'isbn13', 'subtitle', 'authors',
            'description', 'pageCount', 'subjects', 'tags', 'subjectPlaces',
            'subjectPeople', 'subjectTimes', 'contributions', 'publisher',
            'publishedDate', 'firstPublishDate', 'language', 'languageCode',
            'origin', 'coverUrl', 'editionId', 'workId', 'previewUrl',
            'sourceUrl', 'publisherLogoUrl', 'metadataSource', 'isbnApiData',
            'isbnApiEditionData', 'isbnApiWorkData', 'metadataProviders',
            'title', 'author', 'titleSearch', 'isbnSearches', 'updatedAt'
          ])
        );
      allow delete: if signedIn() &&
        resource.data.get('recordType', '') == 'book' &&
        resource.data.get('libraryCount', 0) == 1 &&
        resource.data.get('libraryOwnerCounts', {}).get(request.auth.uid, 0) == 1;
    }

    match /libraryBooks/{libraryBookId} {
      allow read: if signedIn() &&
        (resource.data.libraryId == request.auth.uid ||
          isFriend(request.auth.uid, resource.data.libraryId));
      allow create: if signedIn() &&
        canEditLibrary(request.resource.data.libraryId) &&
        request.resource.data.bookId is string &&
        getAfter(
          /databases/$(database)/documents/books/$(request.resource.data.bookId)
        ).data.get('recordType', '') == 'book';
      allow update: if signedIn() &&
        canEditLibrary(resource.data.libraryId) &&
        request.resource.data.libraryId == resource.data.libraryId &&
        request.resource.data.bookId == resource.data.bookId;
      allow delete: if canEditLibrary(resource.data.libraryId);

      match /ratings/{ratingId} {
        allow read: if signedIn() &&
          (get(
              /databases/$(database)/documents/libraryBooks/$(libraryBookId)
            ).data.libraryId == request.auth.uid ||
            isFriend(
              request.auth.uid,
              get(
                /databases/$(database)/documents/libraryBooks/$(libraryBookId)
              ).data.libraryId
            ));
        allow create, update: if signedIn() &&
          ratingId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.value is int &&
          request.resource.data.value >= 1 &&
          request.resource.data.value <= 5 &&
          request.resource.data.get('review', '') is string &&
          request.resource.data.get('review', '').size() <= 2000 &&
          (get(
              /databases/$(database)/documents/libraryBooks/$(libraryBookId)
            ).data.libraryId == request.auth.uid ||
            isFriend(
              request.auth.uid,
              get(
                /databases/$(database)/documents/libraryBooks/$(libraryBookId)
              ).data.libraryId
            ));
        allow delete: if signedIn() &&
          (ratingId == request.auth.uid ||
            get(
              /databases/$(database)/documents/libraryBooks/$(libraryBookId)
            ).data.libraryId == request.auth.uid) &&
          (get(
              /databases/$(database)/documents/libraryBooks/$(libraryBookId)
            ).data.libraryId == request.auth.uid ||
            isFriend(
              request.auth.uid,
              get(
                /databases/$(database)/documents/libraryBooks/$(libraryBookId)
              ).data.libraryId
            ));
      }

      match /favorites/{favoriteId} {
        allow read: if signedIn() &&
          (get(
              /databases/$(database)/documents/libraryBooks/$(libraryBookId)
            ).data.libraryId == request.auth.uid ||
            isFriend(
              request.auth.uid,
              get(
                /databases/$(database)/documents/libraryBooks/$(libraryBookId)
              ).data.libraryId
            ));
        allow create, update: if signedIn() &&
          favoriteId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.keys().hasOnly(['userId', 'createdAt']) &&
          (get(
              /databases/$(database)/documents/libraryBooks/$(libraryBookId)
            ).data.libraryId == request.auth.uid ||
            isFriend(
              request.auth.uid,
              get(
                /databases/$(database)/documents/libraryBooks/$(libraryBookId)
              ).data.libraryId
            ));
        allow delete: if signedIn() &&
          favoriteId == request.auth.uid &&
          (get(
              /databases/$(database)/documents/libraryBooks/$(libraryBookId)
            ).data.libraryId == request.auth.uid ||
            isFriend(
              request.auth.uid,
              get(
                /databases/$(database)/documents/libraryBooks/$(libraryBookId)
              ).data.libraryId
            ));
      }
    }

    match /loanRequests/{requestId} {
      allow get: if signedIn() && !exists(/databases/$(database)/documents/loanRequests/$(requestId));
      allow read: if signedIn() &&
        exists(/databases/$(database)/documents/libraryBooks/$(resource.data.bookId)) &&
        (resource.data.ownerId == request.auth.uid ||
          resource.data.requesterId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.requesterId == request.auth.uid &&
        validLoanRequest();
      function validLoanRequest() {
        let libraryBook = get(
          /databases/$(database)/documents/libraryBooks/$(request.resource.data.bookId)
        ).data;
        let book = get(
          /databases/$(database)/documents/books/$(libraryBook.bookId)
        ).data;
        return requestId == request.resource.data.bookId + '_' + request.auth.uid &&
          request.resource.data.ownerId == libraryBook.libraryId &&
          isFriend(request.auth.uid, libraryBook.libraryId) &&
          request.auth.uid != libraryBook.libraryId &&
          book.get('recordType', '') == 'book' &&
          libraryBook.get('wishlist', false) != true &&
          libraryBook.get('borrower', null) == null &&
          request.resource.data.status == 'pending';
      }
      allow update: if signedIn() && (
        (
          resource.data.requesterId == request.auth.uid &&
          resource.data.status in ['approved', 'rejected'] &&
          request.resource.data.status == 'pending' &&
          request.resource.data.bookId == resource.data.bookId &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.requesterId == resource.data.requesterId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'createdAt', 'respondedAt'
          ]) &&
          validLoanRequest()
        ) || (
          resource.data.ownerId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']) &&
          (request.resource.data.status == 'rejected' || (
            request.resource.data.status == 'approved' &&
            get(/databases/$(database)/documents/libraryBooks/$(resource.data.bookId)).data.get('borrower', null) == null &&
            getAfter(/databases/$(database)/documents/libraryBooks/$(resource.data.bookId)).data.get('borrowerUserId', null) == resource.data.requesterId &&
            getAfter(/databases/$(database)/documents/libraryBooks/$(resource.data.bookId)).data.get('loanRequestId', null) == requestId
          ))
        )
      );
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.toId == request.auth.uid;
      allow update: if signedIn() &&
        exists(/databases/$(database)/documents/libraryBooks/$(resource.data.bookId)) &&
        resource.data.toId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
      allow create: if signedIn() &&
        request.resource.data.fromId == request.auth.uid &&
        request.resource.data.toId != request.auth.uid && request.resource.data.read == false &&
        validNotification();
      function validNotification() {
        let data = request.resource.data;
        let libraryBook = getAfter(
          /databases/$(database)/documents/libraryBooks/$(data.bookId)
        ).data;
        return (data.type == 'loanReminder' &&
            libraryBook.libraryId == request.auth.uid &&
            libraryBook.borrowerUserId == data.toId) ||
          (data.type == 'loanRequest' && libraryBook.libraryId == data.toId &&
            getAfter(/databases/$(database)/documents/loanRequests/$(data.requestId)).data.requesterId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/loanRequests/$(data.requestId)).data.status == 'pending') ||
          (data.type == 'loanApproved' &&
            libraryBook.libraryId == request.auth.uid &&
            libraryBook.borrowerUserId == data.toId &&
            getAfter(/databases/$(database)/documents/loanRequests/$(data.requestId)).data.status == 'approved');
      }
    }

    match /borrowers/{borrowerId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
  }
}
